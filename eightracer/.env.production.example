APP_NAME=Eightracer
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-school.example
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eightracer_db
DB_USERNAME=eightracer_app
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
FRONTEND_URLS=https://your-school.example
GEMINI_API_KEY=
