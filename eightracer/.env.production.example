APP_NAME=Eightracer
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-school.example
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
FRONTEND_URLS=https://your-school.example
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT=90
CLAMAV_ENDPOINT=tcp://127.0.0.1:3310
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_URL=https://your-school.example/reset-password
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Eightracer

# Alur OTP PRD: aktifkan sesudah SMTP/pengirim teruji
EMAIL_OTP_ENABLED=false
GOOGLE_CLIENT_ID=
SCHOOL_SUPPORT_EMAIL=
MINIMUM_PUBLIC_COHORT=5
QUEUE_CONNECTION=sync

DB_SSLMODE=require
DB_SSLROOTCERT=
DB_EMULATE_PREPARES=false
SCHEDULER_SECRET=
# Only relevant to Laravel stateful-cookie clients; the Next.js BFF uses Bearer.
SANCTUM_STATEFUL_DOMAINS=your-school.example
