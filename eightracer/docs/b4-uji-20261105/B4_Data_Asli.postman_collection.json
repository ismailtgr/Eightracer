{
  "info": {
    "_postman_id": "5108559e-c7ec-4e6b-a873-924a2e1d807f",
    "name": "Eightracer B4 - Baca Data Sekolah Asli",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Data sekolah asli: hanya login, baca, logout. Tidak ada operasi tambah/edit/arsip data sekolah. Login akun admin yang sama akan mencabut sesi lamanya. Password/token awal kosong."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('base_url') !== 'https://laptop-3qspir74.tail5f273f.ts.net/api') {pm.execution.skipRequest(); throw new Error('Gunakan HTTPS database utama untuk koleksi baca data asli.');}",
          "const method=pm.request.method; const url=pm.variables.replaceIn(pm.request.url.toString());",
          "if (method !== 'GET' && !(method === 'POST' && /\\/(login|logout)$/.test(url))) {pm.execution.skipRequest(); throw new Error('Koleksi ini hanya untuk membaca data sekolah.');}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Login admin database utama",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.environment.set('admin_token',pm.response.json().token);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Identitas admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
