      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('base_url');",
          "const allowed = [\"http://127.0.0.1:8001/api\", \"https://laptop-3qspir74.tail5f273f.ts.net/b4-test/api\"];",
          "if (!allowed.includes(base)) { pm.execution.skipRequest(); throw new Error('Gunakan base URL database uji yang sudah disetujui.'); }",
          "pm.sendRequest({url: base.replace(/\\/api$/, '/up'), method: 'GET'}, (err, response) => {",
          "  if (err || response.code !== 200 || response.headers.get('X-Eightracer-Environment') !== 'b4-test-20261105') {",
          "    pm.execution.skipRequest(); throw new Error('Penanda database uji tidak cocok. Request dibatalkan.');",
          "  }",
          "});"
        ]
      }
