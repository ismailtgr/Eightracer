          <mxGeometry as="geometry" x="3080" y="165" width="36" height="36" />
        </mxCell>
        <mxCell id="public" value="Pengunjung membuka informasi / FAQ&#10;UC01" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rounded=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2810" y="245" width="580" height="95" />
