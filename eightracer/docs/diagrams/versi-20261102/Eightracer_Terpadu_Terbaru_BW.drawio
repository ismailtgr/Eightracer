        <mxCell id="authmerge" value="" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3080" y="595" width="40" height="40" />
        </mxCell>
        <mxCell id="auth" value="Daftar &amp; verifikasi / login / reset OTP&#10;UC02–UC04&#10;Periksa NISN + email master; Google memakai nonce" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rounded=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2760" y="655" width="680" height="150" />
        </mxCell>
        <mxCell id="authorized" value="Token sah, role sesuai&#10;dan lingkup data benar?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2910" y="900" width="380" height="175" />
        </mxCell>
        <mxCell id="deny" value="401 / 403 / 422 / 429&#10;Tampilkan pesan umum; perbaiki input / login ulang" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rounded=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3770" y="905" width="650" height="160" />
        </mxCell>
        <mxCell id="menu" value="Pilih operasi&#10;sesuai kewenangan" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2890" y="1190" width="420" height="170" />
        </mxCell>
        <mxCell id="no_login_end" value="" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;shape=doubleEllipse;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="4050" y="440" width="36" height="36" />
        </mxCell>
        <mxCell id="read" value="LAYANAN UMUM &amp; BACA&#10;UC05–06, UC10, UC13, UC16–17,&#10;UC21, UC23, UC25&#10;Profil sendiri; hasil sendiri; jejak berizin" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rounded=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="1560" width="1050" height="160" />
        </mxCell>
