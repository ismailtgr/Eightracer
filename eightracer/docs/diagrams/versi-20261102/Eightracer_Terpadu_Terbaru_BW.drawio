        <mxCell id="needlogin" value="Perlu fitur&#10;terlindungi?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2950" y="410" width="300" height="160" />
