        <mxCell id="title" value="03 Activity — alur sistem terpadu" style="text;html=0;fontColor=#000000;fillColor=none;strokeColor=none;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="15" width="6180" height="42" />
        </mxCell>
        <mxCell id="subtitle" value="Cabang menu adalah pilihan operasi. Validasi token/peran/pemilik berlaku setiap request. Cabang B4 memisahkan perhitungan, AI dan tinjauan admin." style="text;html=0;fontColor=#000000;fillColor=none;strokeColor=none;fontSize=18;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="64" width="6180" height="68" />
