APP_NAME=Eightracer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT=90

# ─── Frontend / CORS ────────────────────────────────────────────────
# Daftar URL frontend yang diizinkan CORS (pisahkan dengan koma).
# Lokal:
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
# Produksi (ganti placeholder):
# FRONTEND_URLS=https://eightracer.vercel.app

# ─── Sanctum ─────────────────────────────────────────────────────────
# Domain stateful untuk cookie-based auth (pisahkan dengan koma).
# Lokal:
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# Produksi (ganti placeholder):
# SANCTUM_STATEFUL_DOMAINS=eightracer.vercel.app

# ─── App ─────────────────────────────────────────────────────────────
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Produksi (ganti placeholder):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://eightracer-be.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (Supabase Postgres) ────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_SSLROOTCERT=
DB_EMULATE_PREPARES=false
#
# Catatan: untuk trafik lebih tinggi, gunakan connection pooling Supabase
# (Supavisor) alih-alih direct connection. Ganti DB_HOST dan DB_PORT:
#   DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com   (lihat dashboard Supabase)
#   DB_PORT=6543
#   DB_USERNAME=postgres
# Mode pooling: transaction (default Supavisor). Jangan gunakan prepared
# statements pada transaction pooler: set DB_EMULATE_PREPARES=true.
# Direct: user postgres. Shared pooler: user postgres.PROJECT_REF.
# Salin host dari Connect Supabase; jangan menebak host atau project ref.

# ─── Session / Cache / Queue ─────────────────────────────────────────
# Render free tier: gunakan file/sync (tidak ada Redis/DB worker).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ─── Mail ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Cloud Storage (opsional) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Keamanan API ────────────────────────────────────────────────────
API_REQUIRE_HTTPS=false
# Produksi:
# API_REQUIRE_HTTPS=true

# ─── Autentikasi dan publikasi sesuai PRD ────────────────────────────
EMAIL_OTP_ENABLED=false
GOOGLE_CLIENT_ID=
SCHOOL_SUPPORT_EMAIL=
MINIMUM_PUBLIC_COHORT=5

# External cron: POST /api/internal/run-scheduler with X-Scheduler-Secret.
# Generate a random secret of at least 32 characters; never put it in the URL.
SCHEDULER_SECRET=
